{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeSSMReaderRoleInInfraAccount",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::SSM_ACCOUNT_ID:role/t12-ssm-reader"
    },
    {
      "Sid": "CloudWatchPushHealthMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "T12/Training"
        }
      }
    }
  ]
}
