{
    "train_batch_size": 8,
    "train_micro_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": 8,
    
    "scheduler": {
        "type": "WarmupDecayLR",
        "params": {
            "warmup_min_lr": 0,
            "warmup_max_lr": 1e-4,
            "warmup_num_steps": 10,
            "total_num_steps": 100
        }
    },
    
    "zero_optimization": {
        "stage": 0,
        "reduce_bucket_size": 5e6,
        "allgather_bucket_size": 5e6
    },
    
    "fp16": {
        "enabled": false
    },
    
    "gradient_clipping": 1.0,
    "steps_per_print": 1,
    "wall_clock_breakdown": false,
    "dump_state": false
}
