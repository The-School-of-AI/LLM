{
  "_comment": "Starter config. For team presets use configs/1b_presets or configs/moe_team8.",

  "hardware": {
    "num_gpus": 8,
    "price_per_gpu_hour": 2.5,
    "tflops_per_gpu": {
      "bf16": 989.0,
      "fp8": 1979.0,
      "nvfp4": 3500.0
    }
  },

  "zero_optimization": {
    "stage": 2,
    "offload_optimizer": { "device": "none" },
    "offload_param": { "device": "none" }
  },

  "activation_checkpointing": {
    "partition_activations": false
  },

  "bf16": { "enabled": true },

  "train_micro_batch_size_per_gpu": 1,
  "gradient_accumulation_steps": 1,
  "mfu": 0.3,

  "stages": [
    {
      "name": "Example 1B Base",
      "total_tokens": 20000000000,
      "architecture": {
        "vocab_size": 50304,
        "hidden_size": 2048,
        "intermediate_size": 4096,
        "num_layers": 16,
        "sequence_length": 4096,

        "num_heads": 16,
        "num_kv_heads": 4,
        "attention_type": "gqa:4:1",

        "tie_embeddings": true,

        "position_embedding_type": "rope",
        "rope_scaling": {
          "type": "yarn",
          "original_max_position": 4096,
          "factor": 8.0
        },

        "use_multi_token_prediction": false
      }
    }
  ]
}